<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.tradingdesk.controller.AboutController"
            fitToWidth="true" styleClass="view-scroll">

    <VBox styleClass="view-root">
        <VBox styleClass="card" spacing="12">
            <HBox spacing="18" alignment="CENTER_LEFT">
                <StackPane fx:id="logoHolder"/>
                <VBox spacing="4">
                    <Label fx:id="nameLabel" styleClass="about-name"/>
                    <Label fx:id="subtitleLabel" styleClass="about-subtitle"/>
                    <Label fx:id="versionLabel" styleClass="card-hint"/>
                </VBox>
            </HBox>
            <Label fx:id="disclaimerValue" styleClass="disclaimer" wrapText="true"/>
        </VBox>

        <GridPane hgap="11" vgap="11">
            <columnConstraints>
                <ColumnConstraints percentWidth="50"/>
                <ColumnConstraints percentWidth="50"/>
            </columnConstraints>

            <VBox styleClass="card" GridPane.columnIndex="0" spacing="10">
                <Label text="SYSTEM" styleClass="card-title"/>
                <GridPane hgap="10" vgap="8">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="42"/>
                        <ColumnConstraints percentWidth="58"/>
                    </columnConstraints>
                    <Label text="Database" styleClass="about-key" GridPane.rowIndex="0"/>
                    <Label fx:id="dbStatusValue" text="-" styleClass="about-value" wrapText="true"
                           GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                    <Label text="Runtime" styleClass="about-key" GridPane.rowIndex="1"/>
                    <Label fx:id="runtimeValue" text="-" styleClass="about-value"
                           GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                    <Label text="Workers" styleClass="about-key" GridPane.rowIndex="2"/>
                    <Label fx:id="workersValue" text="-" styleClass="about-value"
                           GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                    <Label text="Instruments" styleClass="about-key" GridPane.rowIndex="3"/>
                    <Label fx:id="instrumentsValue" text="-" styleClass="about-value" wrapText="true"
                           GridPane.rowIndex="3" GridPane.columnIndex="1"/>
                </GridPane>
            </VBox>

            <VBox styleClass="card" GridPane.columnIndex="1" spacing="10">
                <Label text="SIGNAL MODEL" styleClass="card-title"/>
                <Label fx:id="modeValue" styleClass="about-body" wrapText="true"/>
                <Label text="Indicator set: SMA, EMA, Rate of Change, rolling volatility and simulated order-book imbalance. Signals are deterministic rules, not a trained classifier."
                       styleClass="card-hint" wrapText="true"/>
            </VBox>
        </GridPane>

        <VBox styleClass="card" spacing="8">
            <Label text="TECHNOLOGY" styleClass="card-title"/>
            <Label text="Java 21 · JavaFX 21 (FXML + CSS) · Maven 3.9 · MySQL 9.7 via JDBC"
                   styleClass="about-body" wrapText="true"/>
            <Label text="Concurrency: ExecutorService, LinkedBlockingQueue, ConcurrentHashMap, AtomicLong/LongAdder, ScheduledExecutorService, ReentrantLock."
                   styleClass="card-hint" wrapText="true"/>
        </VBox>
    </VBox>
</ScrollPane>
